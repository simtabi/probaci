# Binaries
/probaci
/bin/
/dist/
# Generated build output. build/ keeps its tracked inputs (targets.txt, and
# nfpm.yaml if one is added); everything else in it is generated, one folder
# per OS (see the Makefile).
/build/*
!/build/targets.txt
!/build/nfpm.yaml
# GoReleaser's scratch dist (src/.goreleaser.yaml `dist:`).
/.cache/
*.exe
*.test
*.out

# Go
/vendor/
coverage.txt
coverage.html

# probaci local state
.probaci/
probaci.json.*.bak

# generated by scripts/pin-digests.sh
tools.pinned.json
pin-digests.log

# Editor / OS
.idea/
.vscode/
.DS_Store
